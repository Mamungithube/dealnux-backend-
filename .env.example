# ==========================================
# Dealnux Backend Environment Variables
# ==========================================

# Core Django Settings
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
SITE_URL=http://localhost:8000
ADMIN_EMAIL=admin@dealnux.com

# Allowed Hosts & Security (comma-separated, e.g. localhost,127.0.0.1,dealnux.com)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000

# Session & Cookie Security
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

# Database Settings (PostgreSQL)
# Note: When using Docker Compose, set DB_HOST=db and DB_PORT=5432
# For local Python execution without Docker, use DB_HOST=localhost and DB_PORT=5433
DB_NAME=dealnux_db
DB_USER=dealnux_user
DB_PASSWORD=your_secure_db_password
DB_HOST=db
DB_PORT=5432
CONN_MAX_AGE=600

# Redis & Cache Settings
# Note: Use 'redis' for Docker, 'localhost' for local setup
REDIS_URL=redis://redis:6379/0

# Email (SMTP) Settings
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=noreply@dealnux.shop

# Google OAuth2 Settings
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_OAUTH2_CLIENT_ID=your_google_client_id
GOOGLE_OAUTH2_CLIENT_SECRET=your_google_client_secret
GOOGLE_OAUTH2_REDIRECT_URI=http://localhost:8000/api/v1/account/google/callback/

# Apple OAuth / In-App Purchase
APPLE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_TEAM_ID=
APPLE_PRIVATE_KEY=

# External APIs (RapidAPI & Deal scrapers)
RAPIDAPI_KEY=your_rapidapi_key_here

# Stripe Payment & Connect Settings
STRIPE_PUBLIC_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_SUCCESS_URL=http://localhost:3000/payment/success
STRIPE_CANCEL_URL=http://localhost:3000/payment/cancel
STRIPE_CONNECT_REFRESH_URL=http://localhost:3000/seller/payout/refresh
STRIPE_CONNECT_RETURN_URL=http://localhost:3000/seller/payout/complete

# API Documentation Credentials (Optional Basic Auth)
DOCS_USERNAME=docsuser
DOCS_PASSWORD=changeme